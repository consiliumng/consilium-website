---
layout: base.njk
title: Consilium — Nigerian Health Systems Intelligence
description: Nigeria's health systems intelligence and advisory firm. Primary research on workforce, financing, and market access for institutional decision-makers.
activePage: home
permalinkPath: ""
permalink: index.html
---
<style>
/* ============================================================
       TOKENS
    ============================================================ */
    :root {
      --blue:         #3D35EB;
      --blue-deep:    #2D28C8;
      --ink:          #123184;
      --ink-light:    #2CB1F4;
      --lime:         #C8F5A0;
      --amber:        #F5A623;
      --grey-bg:      #F4F4F8;
      --grey-border:  #E0E0E8;
      --white:        #ffffff;
      --body-sec:     #4A4A63;
      --r-card:       16px;
      --r-pill:       48px;
      --ease:         0.22s ease;
    }

    /* ============================================================
       RESET & BASE
    ============================================================ */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 16px;
      line-height: 1.7;
      color: var(--ink);
      background: var(--grey-bg);
      -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3, h4 {
      font-family: 'Fraunces', serif;
      font-optical-sizing: auto;
      line-height: 1.1;
      letter-spacing: -0.02em;
      text-wrap: balance;
    }

    a { color: inherit; text-decoration: none; }

    /* ============================================================
       LAYOUT
    ============================================================ */
    .wrap {
      max-width: 1140px;
      margin: 0 auto;
      padding: 0 clamp(20px, 5vw, 60px);
    }

    section { padding: clamp(80px, 11vw, 128px) 0; }

    .two-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: clamp(32px, 5vw, 80px);
      align-items: start;
    }

    /* ============================================================
       EYEBROW
    ============================================================ */
    .eyebrow {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 20px;
      width: 100%;
    }
    .eyebrow::before {
      content: '';
      display: block;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
      flex-shrink: 0;
    }
    /* Hairline rule extending from the label to the right edge */
    .eyebrow::after {
      content: '';
      flex: 1;
      height: 1px;
      background: currentColor;
      opacity: 0.18;
      display: block;
    }

    /* ============================================================
       UNIVERSAL HOVER — underline animation for text links
    ============================================================ */
    .link-ul {
      display: inline-block;
      position: relative;
    }
    .link-ul::after {
      content: '';
      display: block;
      height: 1.5px;
      background: var(--blue-deep);
      width: 0;
      transition: width var(--ease);
      position: absolute;
      bottom: -1px;
      left: 0;
    }
    .link-ul:hover::after { width: 100%; }

    /* ============================================================
       BUTTONS
    ============================================================ */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 12px 24px;
      border-radius: var(--r-pill);
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      border: 1.5px solid transparent;
      transition: background var(--ease), border-color var(--ease), color var(--ease);
      white-space: nowrap;
    }

    /* white fill (on blue bg) */
    .btn-white {
      background: var(--white);
      color: var(--blue);
      border-color: var(--white);
    }
    .btn-white:hover { background: var(--grey-bg); border-color: var(--grey-bg); }

    /* ghost white (on blue bg) */
    .btn-ghost-w {
      background: transparent;
      color: var(--white);
      border-color: rgba(255,255,255,0.4);
    }
    .btn-ghost-w:hover { border-color: var(--white); }

    /* blue fill (on light bg) */
    .btn-blue {
      background: var(--blue);
      color: var(--white);
      border-color: var(--blue);
    }
    .btn-blue:hover { background: var(--blue-deep); border-color: var(--blue-deep); }

    /* ghost blue (on light bg) */
    .btn-ghost {
      background: transparent;
      color: var(--ink);
      border-color: var(--grey-border);
    }
    .btn-ghost:hover { border-color: var(--blue-deep); color: var(--blue-deep); }

    /* small variant */
    .btn-sm { font-size: 13px; padding: 9px 18px; }

    /* ============================================================
       NAV
    ============================================================ */
    /* Nav icon fills — dark theme (default, on blue) */
    .nav-icon-primary   { fill: #ffffff; transition: fill 0.3s ease; }
    .nav-icon-secondary { fill: rgba(255,255,255,0.65); transition: fill 0.3s ease; }

    nav {
      position: sticky;
      top: 0;
      z-index: 100;
      background: var(--blue);
      height: 64px;
      display: flex;
      align-items: center;
      transition: background-color 0.35s ease;
    }

    /* Light nav — grey/white sections */
    nav[data-theme="light"] { background: var(--grey-bg); }
    nav[data-theme="light"] .nav-logo { color: var(--ink); }
    nav[data-theme="light"] .nav-icon-primary   { fill: var(--ink); }
    nav[data-theme="light"] .nav-icon-secondary { fill: var(--ink-light); }
    nav[data-theme="light"] .nav-links a { color: rgba(18,48,132,0.65); }
    nav[data-theme="light"] .nav-links a::after { background: var(--ink); }
    nav[data-theme="light"] .nav-links a:hover { color: var(--ink); }
    nav[data-theme="light"] .nav-cta {
      background: rgba(61,53,235,0.08) !important;
      color: var(--blue) !important;
      border-color: rgba(61,53,235,0.25) !important;
    }
    nav[data-theme="light"] .nav-cta:hover {
      background: rgba(61,53,235,0.15) !important;
    }
    nav[data-theme="light"] .hamburger span { background: var(--ink); }

    .nav-inner {
      max-width: 1140px;
      margin: 0 auto;
      padding: 0 clamp(20px, 5vw, 60px);
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
    }

    .nav-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      color: var(--white);
      font-size: 17px;
      font-weight: 600;
      letter-spacing: -0.3px;
      text-decoration: none;
      flex-shrink: 0;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: clamp(16px, 2.5vw, 30px);
      list-style: none;
    }

    .nav-links a {
      color: rgba(255,255,255,0.78);
      font-size: 14px;
      font-weight: 500;
      text-decoration: none;
      transition: color var(--ease);
      position: relative;
      display: inline-block;
    }
    .nav-links a::after {
      content: '';
      display: block;
      height: 1.5px;
      background: var(--white);
      width: 0;
      transition: width var(--ease);
    }
    .nav-links a:hover { color: var(--white); }
    .nav-links a:hover::after { width: 100%; }

    .nav-cta {
      background: rgba(255,255,255,0.15) !important;
      color: var(--white) !important;
      border: 1px solid rgba(255,255,255,0.3) !important;
      padding: 8px 18px !important;
      border-radius: var(--r-pill) !important;
      font-weight: 600 !important;
    }
    .nav-cta::after { display: none !important; }
    .nav-cta:hover { background: rgba(255,255,255,0.26) !important; border-color: rgba(255,255,255,0.55) !important; }

    .hamburger {
      display: none;
      flex-direction: column;
      gap: 5px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 4px;
    }
    .hamburger span { display: block; width: 22px; height: 2px; background: var(--white); }

    .mobile-menu {
      display: none;
      position: absolute;
      top: 64px;
      left: 0;
      right: 0;
      background: var(--blue-deep);
      padding: 8px 24px 24px;
      z-index: 99;
    }
    .mobile-menu.open { display: block; }
    .mobile-menu a {
      display: block;
      color: rgba(255,255,255,0.82);
      font-size: 16px;
      padding: 14px 0;
      border-bottom: 1px solid rgba(255,255,255,0.1);
      text-decoration: none;
    }
    .mobile-menu a:last-child { border-bottom: none; color: var(--white); font-weight: 600; }

    /* ============================================================
       HERO
    ============================================================ */
    .hero {
      background: var(--blue);
      padding: clamp(80px, 11vw, 130px) 0 clamp(88px, 11vw, 140px);
      min-height: 80vh;
      display: flex;
      align-items: center;
      position: relative;
    }

    .hero-centered {
      text-align: center;
      max-width: 800px;
      margin: 0 auto;
    }

    .hero h1 {
      font-size: clamp(48px, 8vw, 104px);
      font-variation-settings: "opsz" 144, "wght" 700;
      color: var(--white);
      line-height: 1.0;
      margin-top: 6px;
      margin-bottom: 28px;
    }

    .hero-tagline {
      font-size: clamp(15px, 1.4vw, 17px);
      color: rgba(255,255,255,0.72);
      line-height: 1.72;
      margin: 0 auto 36px;
      max-width: 680px;
    }

    .hero-ctas {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      justify-content: center;
    }

    /* ============================================================
       WHY THIS MATTERS
    ============================================================ */
    .matters { background: var(--grey-bg); }

    .stat-col { position: sticky; top: 88px; }

    .stat-figure {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(88px, 13vw, 148px);
      color: var(--blue);
      line-height: 0.95;
      letter-spacing: 0.01em;
      margin-bottom: 12px;
    }

    .stat-label {
      font-size: 14px;
      color: var(--body-sec);
      line-height: 1.6;
      max-width: 210px;
      padding-top: 8px;
      border-top: 1.5px solid var(--grey-border);
    }

    .matters-text h2 {
      font-size: clamp(26px, 3.5vw, 40px);
      margin-bottom: 24px;
      color: var(--ink);
    }

    .matters-text p {
      font-size: 15.5px;
      color: var(--body-sec);
      margin-bottom: 18px;
      line-height: 1.75;
    }
    .matters-text p:last-child { margin-bottom: 0; }

    /* ============================================================
       WHAT WE DO
    ============================================================ */
    .what { background: var(--blue); position: relative; }

    .what-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: clamp(40px, 5vw, 64px);
      gap: 32px;
    }

    .what h2 {
      font-size: clamp(30px, 4vw, 50px);
      color: var(--white);
      max-width: 460px;
    }

    .what-sub {
      font-size: 14px;
      color: rgba(255,255,255,0.6);
      max-width: 260px;
      text-align: right;
      line-height: 1.65;
    }

    .accordion { border-top: 1px solid rgba(255,255,255,0.18); }

    .acc-item { border-bottom: 1px solid rgba(255,255,255,0.18); }

    .acc-trigger {
      width: 100%;
      background: none;
      border: none;
      display: flex;
      align-items: center;
      gap: 20px;
      padding: 26px 0;
      cursor: pointer;
      text-align: left;
      transition: opacity var(--ease);
    }
    .acc-trigger:hover { opacity: 0.82; }

    .acc-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--lime);
      flex-shrink: 0;
      transition: background var(--ease);
    }
    .acc-item.open .acc-dot { background: var(--white); }

    .acc-title {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: clamp(13px, 1.5vw, 15px);
      font-weight: 600;
      letter-spacing: 1.8px;
      text-transform: uppercase;
      color: var(--white);
      flex: 1;
    }

    .acc-chevron {
      width: 20px;
      height: 20px;
      flex-shrink: 0;
      color: rgba(255,255,255,0.55);
      transition: transform 0.3s ease;
    }
    .acc-item.open .acc-chevron { transform: rotate(180deg); }

    .acc-body-wrap {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 0.36s ease;
    }
    .acc-item.open .acc-body-wrap { grid-template-rows: 1fr; }
    .acc-body-wrap > div { overflow: hidden; }

    .acc-body {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      padding: 0 0 32px 28px;
    }

    .acc-desc {
      font-size: 15px;
      color: rgba(255,255,255,0.72);
      line-height: 1.75;
    }

    .acc-link {
      font-size: 13px;
      font-weight: 600;
      color: var(--lime);
      align-self: start;
      margin-top: 4px;
      display: inline-block;
      position: relative;
    }
    .acc-link::after {
      content: '';
      display: block;
      height: 1.5px;
      background: var(--lime);
      width: 0;
      transition: width var(--ease);
    }
    .acc-link:hover::after { width: 100%; }

    /* ============================================================
       WORK
    ============================================================ */
    .work { background: var(--grey-bg); }

    .work-intro {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: clamp(36px, 5vw, 56px);
      gap: 24px;
    }

    .work h2 { font-size: clamp(28px, 3.5vw, 44px); }

    .work-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    .work-card {
      background: var(--white);
      border: 1px solid var(--grey-border);
      border-radius: var(--r-card);
      overflow: hidden;
      display: block;
      transition: border-color var(--ease), box-shadow var(--ease);
      color: inherit;
      position: relative;
    }
    .work-card:hover {
      border-color: var(--blue);
      box-shadow: 0 0 0 1px var(--blue);
    }

    /* Image-based card preview — used when image_url is set in REPORTS */
    .card-preview-img {
      height: 230px;
      background-size: cover;
      background-position: center top;
      position: relative;
      overflow: hidden;
    }
    .card-preview-img::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 55%;
      background: linear-gradient(transparent, rgba(18,48,132,0.72));
      pointer-events: none;
    }

    .card-preview { height: 230px; position: relative; overflow: hidden; }

    /* report card preview */
    .preview-report {
      background: var(--ink);
      height: 100%;
      display: flex;
      align-items: flex-end;
      padding: 20px 22px;
      position: relative;
    }
    .preview-report::before {
      content: '';
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(
        0deg, transparent, transparent 22px,
        rgba(255,255,255,0.035) 22px, rgba(255,255,255,0.035) 23px
      );
    }
    .preview-report::after {
      content: '';
      position: absolute;
      top: 0; right: 0;
      width: 40%;
      height: 100%;
      background: linear-gradient(135deg, transparent 30%, var(--blue) 100%);
      opacity: 0.5;
    }
    .report-label {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 20px;
      color: var(--white);
      line-height: 1.1;
      letter-spacing: 1px;
      position: relative;
      z-index: 1;
    }
    .report-label span { color: var(--lime); display: block; font-size: 26px; }

    /* tool card preview */
    .preview-tool {
      background: var(--ink);
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 28px;
      padding: 20px;
      position: relative;
    }
    .preview-tool::before {
      content: '';
      position: absolute;
      inset: 0;
      background:
        repeating-linear-gradient(90deg, rgba(255,255,255,0.03) 0, rgba(255,255,255,0.03) 1px, transparent 1px, transparent 56px),
        repeating-linear-gradient(0deg,  rgba(255,255,255,0.03) 0, rgba(255,255,255,0.03) 1px, transparent 1px, transparent 36px);
    }
    .tool-stat { text-align: center; position: relative; z-index: 1; }
    .tool-num {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 40px;
      color: var(--lime);
      line-height: 1;
      display: block;
    }
    .tool-lbl {
      font-size: 9px;
      font-weight: 600;
      letter-spacing: 1.3px;
      text-transform: uppercase;
      color: rgba(255,255,255,0.5);
    }

    .card-body { 
      padding: 32px 40px 40px 40px;
    }

    /* h3 link spans the whole card; buttons sit above it */
    .work-card h3 a {
      color: inherit;
      text-decoration: none;
    }
    .work-card h3 a::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
    }

    .card-chip {
      display: inline-block;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      background: rgba(61,53,235,0.09);
      color: var(--blue);
      padding: 4px 10px;
      border-radius: 6px;
      margin-bottom: 12px;
    }

    .work-card h3 { font-size: clamp(16px, 1.8vw, 20px); margin-bottom: 10px; }

    .work-card p {
      font-size: 14px;
      color: var(--body-sec);
      margin-bottom: 0;
      line-height: 1.65;
    }

    .card-ctas { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 32px; position: relative; z-index: 2; }

    /* ============================================================
       PARTNERSHIP
    ============================================================ */
    .partnership { background: var(--blue); position: relative; }

    .partnership h2 {
      font-size: clamp(30px, 4vw, 52px);
      color: var(--white);
      margin-bottom: 20px;
    }

    .partner-lead {
      font-size: clamp(15px, 1.4vw, 17px);
      color: rgba(255,255,255,0.72);
      line-height: 1.72;
      margin-bottom: 36px;
      max-width: 500px;
    }

    .partner-modes {
      border-top: 1px solid rgba(255,255,255,0.2);
      display: flex;
      flex-direction: column;
    }

    .mode {
      padding: 22px 0;
      border-bottom: 1px solid rgba(255,255,255,0.15);
    }

    .mode-name {
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      color: var(--white);
      margin-bottom: 6px;
    }

    .mode-desc {
      font-size: 14px;
      color: rgba(255,255,255,0.62);
      line-height: 1.65;
    }

    /* ============================================================
       WRITING
    ============================================================ */
    .writing { background: var(--grey-bg); }

    .writing-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: clamp(36px, 5vw, 56px);
      gap: 24px;
    }

    .writing h2 { font-size: clamp(28px, 3.5vw, 44px); }

    .writing-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-bottom: clamp(48px, 6vw, 72px);
    }

    .writing-card {
      background: var(--white);
      border: 1px solid var(--grey-border);
      border-radius: var(--r-card);
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      text-decoration: none;
      color: inherit;
      transition: border-color var(--ease);
    }
    .writing-card:hover { border-color: var(--blue); }

    .writing-tag {
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--blue);
    }

    .writing-card h3 {
      font-size: clamp(15px, 1.6vw, 18px);
      line-height: 1.22;
    }

    .writing-card p {
      font-size: 13px;
      color: var(--body-sec);
      line-height: 1.65;
      flex: 1;
    }

    .writing-arrow {
      font-size: 13px;
      font-weight: 600;
      color: var(--blue);
      margin-top: 4px;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    /* newsletter strip */
    .newsletter {
      background: var(--ink);
      border-radius: var(--r-card);
      padding: clamp(32px, 5vw, 52px);
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: 40px;
      align-items: center;
    }

    .newsletter h3 {
      font-size: clamp(22px, 2.5vw, 30px);
      color: var(--white);
      margin-bottom: 10px;
    }

    .newsletter p {
      font-size: 14px;
      color: rgba(255,255,255,0.62);
      line-height: 1.65;
    }

    .nl-form { display: flex; gap: 10px; }

    .nl-input {
      flex: 1;
      height: 46px;
      padding: 0 18px;
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: var(--r-pill);
      background: rgba(255,255,255,0.08);
      color: var(--white);
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 14px;
      outline: none;
      transition: border-color var(--ease);
    }
    .nl-input::placeholder { color: rgba(255,255,255,0.38); }
    .nl-input:focus { border-color: var(--lime); }

    .nl-btn {
      height: 46px;
      padding: 0 22px;
      background: var(--lime);
      color: var(--ink);
      border: none;
      border-radius: var(--r-pill);
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      white-space: nowrap;
      transition: opacity var(--ease);
    }
    .nl-btn:hover { opacity: 0.85; }

    /* ============================================================
       ABOUT
    ============================================================ */
    .about { background: var(--grey-bg); }

    .about h2 { font-size: clamp(28px, 3.5vw, 42px); margin-bottom: 24px; }

    .about-text p {
      font-size: 15.5px;
      color: var(--body-sec);
      line-height: 1.78;
      margin-bottom: 16px;
    }
    .about-text p:last-child { margin-bottom: 0; }

    .team { display: flex; flex-direction: column; gap: 14px; }

    .team-card {
      background: var(--white);
      border: 1px solid var(--grey-border);
      border-radius: var(--r-card);
      padding: 16px 20px;
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .team-avatar {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: var(--blue);
      color: var(--white);
      font-size: 13px;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .team-name { font-size: 15px; font-weight: 600; }
    .team-role { font-size: 13px; color: var(--body-sec); }

    .team-incoming {
      border-style: dashed;
      opacity: 0.55;
    }

    /* ============================================================
       FOOTER
    ============================================================ */
    footer {
      background: var(--blue);
      padding: clamp(56px, 8vw, 96px) 0 36px;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1.5fr 1fr 1fr;
      gap: 48px;
      margin-bottom: clamp(48px, 6vw, 72px);
    }

    .footer-brand p {
      font-size: 14px;
      color: rgba(255,255,255,0.58);
      line-height: 1.68;
      margin-top: 14px;
      max-width: 240px;
    }

    .footer-col-label {
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: rgba(255,255,255,0.38);
      margin-bottom: 16px;
    }

    .footer-links { list-style: none; display: flex; flex-direction: column; gap: 10px; }

    .footer-links a {
      font-size: 14px;
      color: rgba(255,255,255,0.68);
      display: inline-block;
      position: relative;
      transition: color var(--ease);
    }
    .footer-links a::after {
      content: '';
      display: block;
      height: 1px;
      background: var(--white);
      width: 0;
      transition: width var(--ease);
    }
    .footer-links a:hover { color: var(--white); }
    .footer-links a:hover::after { width: 100%; }

    .footer-nl-label {
      font-size: 13px;
      color: rgba(255,255,255,0.55);
      margin-bottom: 14px;
      line-height: 1.5;
    }

    .footer-nl-form { display: flex; gap: 8px; }

    .footer-nl-input {
      flex: 1;
      height: 38px;
      padding: 0 14px;
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: var(--r-pill);
      background: rgba(255,255,255,0.07);
      color: var(--white);
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 13px;
      outline: none;
      transition: border-color var(--ease);
    }
    .footer-nl-input::placeholder { color: rgba(255,255,255,0.32); }
    .footer-nl-input:focus { border-color: rgba(255,255,255,0.55); }

    .footer-nl-btn {
      height: 38px;
      padding: 0 14px;
      background: rgba(255,255,255,0.14);
      color: var(--white);
      border: 1px solid rgba(255,255,255,0.28);
      border-radius: var(--r-pill);
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: background var(--ease);
    }
    .footer-nl-btn:hover { background: rgba(255,255,255,0.24); }

    .footer-hr { border: none; border-top: 1px solid rgba(255,255,255,0.14); margin-bottom: 24px; }

    .footer-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
    }

    .footer-copy {
      font-size: 12px;
      color: rgba(255,255,255,0.38);
    }
    .footer-copy a { color: rgba(255,255,255,0.38); transition: color var(--ease); }
    .footer-copy a:hover { color: rgba(255,255,255,0.7); }

    .footer-method {
      font-size: 12px;
      color: rgba(255,255,255,0.35);
      text-align: right;
    }

    /* ============================================================
       SCROLL REVEAL — CSS scroll timeline + IntersectionObserver fallback
    ============================================================ */
    .reveal {
      opacity: 0;
      transform: translateY(14px);
      transition: opacity 0.65s ease, transform 0.65s ease;
    }
    .reveal.in-view {
      opacity: 1;
      transform: none;
    }
    @supports (animation-timeline: view()) {
      .reveal {
        opacity: 1;
        transform: none;
        transition: none;
        animation: fadeRise linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 42%;
      }
      @keyframes fadeRise {
        from { opacity: 0; transform: translateY(14px); }
        to   { opacity: 1; transform: translateY(0); }
      }
    }

    /* ============================================================
       CARD METRICS — report card publication line
    ============================================================ */
    .card-metrics {
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.8px;
      color: var(--body-sec);
      text-transform: uppercase;
      padding-top: 16px;
      margin-top: 4px;
      border-top: 1px solid var(--grey-border);
    }

    /* Enhanced book-cover preview for report cards */
    .preview-report {
      background: var(--ink);
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 22px 24px 20px;
      position: relative;
    }
    .preview-report::before {
      content: '';
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(
        0deg, transparent, transparent 22px,
        rgba(255,255,255,0.035) 22px, rgba(255,255,255,0.035) 23px
      );
    }
    .preview-report::after {
      content: '';
      position: absolute;
      top: 0; right: 0;
      width: 40%;
      height: 100%;
      background: linear-gradient(135deg, transparent 30%, var(--blue) 100%);
      opacity: 0.5;
    }
    .report-label {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 18px;
      color: var(--white);
      line-height: 1.15;
      letter-spacing: 1px;
      position: relative;
      z-index: 1;
    }
    .report-label span { color: var(--lime); display: block; font-size: 28px; margin-bottom: 4px; }
    .report-cover-rule {
      width: 40px;
      height: 2px;
      background: var(--lime);
      position: relative;
      z-index: 1;
    }

    /* ============================================================
       FOOTER TAGLINE
    ============================================================ */
    .footer-tagline-block {
      padding-bottom: clamp(40px, 5vw, 64px);
      border-bottom: 1px solid rgba(255,255,255,0.12);
      margin-bottom: clamp(48px, 6vw, 72px);
    }
    .footer-tagline-block p {
      font-family: 'Fraunces', serif;
      font-optical-sizing: auto;
      font-variation-settings: "opsz" 48, "wght" 700;
      font-size: clamp(26px, 3.5vw, 44px);
      color: var(--white);
      line-height: 1.15;
      text-wrap: balance;
      max-width: 640px;
    }

    /* ============================================================
       ABSTRACT DESIGN ELEMENTS
    ============================================================ */

    /* Dot grid on all grey sections — faint graph-paper texture */
    .matters, .work, .writing, .about {
      background-image: radial-gradient(circle, rgba(61,53,235,0.07) 1.5px, transparent 1.5px);
      background-size: 28px 28px;
    }

    /* Icon mark watermark on blue sections — large, low-opacity */
    .hero, .what, .partnership, .why-consilium {
      overflow: hidden;
    }
    .hero::after, .what::after, .partnership::after, .why-consilium::after {
      content: '';
      position: absolute;
      width: 480px;
      height: 534px; /* maintains icon aspect ratio 99.5:110.86 */
      right: -80px;
      bottom: -120px;
      background-image: url("data:image/svg+xml;base64,");
      background-size: contain;
      background-repeat: no-repeat;
      pointer-events: none;
      z-index: 0;
    }

    /* Ensure section content sits above the watermark */
    .hero .wrap, .what .wrap, .partnership .wrap, .why-consilium .wrap {
      position: relative;
      z-index: 1;
    }

    /* ============================================================
       HERO PROOF STRIP
    ============================================================ */
    .hero-proof {
      display: flex;
      gap: clamp(24px, 4vw, 56px);
      margin-top: 48px;
      padding-top: 32px;
      border-top: 1px solid rgba(255,255,255,0.18);
      flex-wrap: wrap;
    }
    .proof-item { display: flex; flex-direction: column; gap: 4px; }
    .proof-number {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(56px, 6vw, 80px);
      color: var(--lime);
      line-height: 1;
      letter-spacing: 0.02em;
    }
    .proof-label {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: rgba(255,255,255,0.55);
    }

    /* ============================================================
       TRUST STRIP — "Who our work serves"
    ============================================================ */
    .trust-strip {
      background: var(--white);
      padding: clamp(48px, 7vw, 80px) 0;
    }
    .trust-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: clamp(24px, 3vw, 40px);
      margin-top: 32px;
    }
    .trust-grid h3 { font-size: clamp(16px, 1.8vw, 19px); margin-bottom: 8px; color: var(--ink); }
    .trust-grid p  { font-size: 14px; color: var(--body-sec); line-height: 1.65; }

    /* ============================================================
       WHY CONSILIUM — blue section
    ============================================================ */
    .why-consilium {
      background: var(--blue);
      padding: clamp(64px, 9vw, 108px) 0;
      position: relative;
    }
    .why-consilium .eyebrow { color: var(--lime); }
    .why-consilium h2 {
      font-size: clamp(28px, 3.5vw, 44px);
      color: var(--white);
      margin-bottom: clamp(36px, 5vw, 56px);
    }
    .why-consilium .writing-grid { margin-bottom: 0; }
    .why-consilium .writing-card {
      background: rgba(255,255,255,0.08);
      border-color: rgba(255,255,255,0.15);
    }
    .why-consilium .writing-card:hover { border-color: rgba(255,255,255,0.45); }
    .why-consilium .writing-card h3 { color: var(--white); }
    .why-consilium .writing-card p   { color: rgba(255,255,255,0.68); }

    /* ============================================================
       METHODOLOGY — grey section
    ============================================================ */
    .methodology {
      background: var(--grey-bg);
      padding: clamp(64px, 9vw, 108px) 0;
      background-image: radial-gradient(circle, rgba(61,53,235,0.07) 1.5px, transparent 1.5px);
      background-size: 28px 28px;
    }
    .methodology .eyebrow { color: var(--blue); }
    .methodology h2 {
      font-size: clamp(28px, 3.5vw, 44px);
      margin-bottom: clamp(36px, 5vw, 56px);
    }

    @media (max-width: 580px) {
      .nav-links { display: none; }
      .hamburger { display: flex; }

      .two-col { grid-template-columns: 1fr; }
      .hero-centered { text-align: left; }
      .hero-ctas { justify-content: flex-start; }
      .hero-tagline { margin-left: 0; }

      .stat-col { position: static; }

      .what-head { flex-direction: column; align-items: flex-start; }
      .what-sub { text-align: left; }
      .acc-body { grid-template-columns: 1fr; gap: 16px; }

      .work-intro { flex-direction: column; align-items: flex-start; gap: 16px; }
      .work-grid { grid-template-columns: 1fr; }

      .writing-head { flex-direction: column; align-items: flex-start; gap: 16px; }
      .writing-grid { grid-template-columns: 1fr; }
      .newsletter { grid-template-columns: 1fr; gap: 28px; }
      .nl-form { flex-direction: column; }

      .footer-grid { grid-template-columns: 1fr; gap: 32px; }
      .footer-bottom { flex-direction: column; align-items: flex-start; gap: 8px; }
      .footer-method { text-align: left; }

      .trust-grid { grid-template-columns: 1fr 1fr; }
      .hero-proof { gap: 16px; }
      .reveal { opacity: 1; transform: none; }
    }

    @media (max-width: 780px) and (min-width: 581px) {
      .writing-grid { grid-template-columns: 1fr 1fr; }
      .footer-grid { grid-template-columns: 1fr 1fr; }
      .footer-brand { grid-column: span 2; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { transition: none !important; }
      .acc-body-wrap { transition: none !important; }
    }
</style>

