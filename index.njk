     FOOTER
============================================================ -->

<script>

  // ============================================================
  // COUNT-UP ANIMATION — hero proof strip numbers
  // ============================================================
  function countUp(el) {
    const end = parseInt(el.textContent.replace(/,/g, ''), 10);
    if (!end) return;
    const duration = 1400;
    const t0 = performance.now();
    function tick(t) {
      const progress = Math.min((t - t0) / duration, 1);
      const ease = 1 - Math.pow(1 - progress, 3); // cubic ease-out
      el.textContent = Math.round(ease * end).toLocaleString();
      if (progress < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  const proofIO = new IntersectionObserver(([entry]) => {
    if (entry.isIntersecting) {
      entry.target.querySelectorAll('.proof-number:not([data-no-count])').forEach(countUp);
      proofIO.disconnect();
    }
  }, { threshold: 0.5 });
  const proofEl = document.querySelector('.hero-proof');
  if (proofEl) proofIO.observe(proofEl);

  // ============================================================
  // SCROLL REVEAL — IntersectionObserver fallback for Firefox
  // and any browser without animation-timeline: view()
  // ============================================================
  if (!CSS.supports('animation-timeline', 'view()')) {
    const revealIO = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('in-view');
          revealIO.unobserve(e.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -48px 0px' });
    document.querySelectorAll('.reveal').forEach(el => revealIO.observe(el));
  }

  // ============================================================
  // ANNOUNCEMENT BANNER — dismiss and restore on new session
  // ============================================================
  (function() {
    const banner = document.getElementById('survey-banner');
    if (sessionStorage.getItem('bannerDismissed')) {
      banner.style.display = 'none';
    }
  })();

  function dismissBanner() {
    document.getElementById('survey-banner').style.display = 'none';
    sessionStorage.setItem('bannerDismissed', '1');
  }

  // ============================================================
  // DYNAMIC NAV THEME — background matches current section
  // ============================================================
  const navEl = document.querySelector('nav');
  const themedSections = document.querySelectorAll('[data-nav-theme]');

  function updateNavTheme() {
    const navBottom = 64; // nav height in px
    let current = null;
    themedSections.forEach(section => {
      const rect = section.getBoundingClientRect();
      if (rect.top <= navBottom && rect.bottom > navBottom) {
        current = section;
      }
    });
    // Also check the footer
    const footer = document.querySelector('footer[data-nav-theme]');
    if (footer) {
      const fr = footer.getBoundingClientRect();
      if (fr.top <= navBottom && fr.bottom > navBottom) current = footer;
    }
    if (current) {
      navEl.setAttribute('data-theme', current.dataset.navTheme);
    }
  }

  window.addEventListener('scroll', updateNavTheme, { passive: true });
  updateNavTheme(); // set correct theme on load

  // Hamburger menu
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobile-menu');

  hamburger.addEventListener('click', () => {
    mobileMenu.classList.toggle('open');
  });

  mobileMenu.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => mobileMenu.classList.remove('open'));
  });

  // Accordion — one open at a time
  document.querySelectorAll('.acc-trigger').forEach(trigger => {
    trigger.addEventListener('click', () => {
      const item = trigger.closest('.acc-item');
      const isOpen = item.classList.contains('open');

      document.querySelectorAll('.acc-item').forEach(i => {
        i.classList.remove('open');
        i.querySelector('.acc-trigger').setAttribute('aria-expanded', 'false');
      });

      if (!isOpen) {
        item.classList.add('open');
        trigger.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
