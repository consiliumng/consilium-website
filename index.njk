          <div class="card-ctas">
            <a href="{{ r.primary_cta_url }}" class="btn btn-blue btn-sm">{{ r.primary_cta_text }}</a>
            {% if r.has_download %}<a href="/reports/{{ r.slug }}/" class="btn btn-ghost btn-sm">Download</a>{% endif %}
          </div>
        </div>
      </div>
      {% endfor %}
    </div>

  </div>
