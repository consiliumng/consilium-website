<script>
// ============================================================
// SHARED BEHAVIOR — mobile nav toggle, newsletter footer form
// ============================================================
(function () {
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobile-menu');
  if (hamburger && mobileMenu) {
    hamburger.addEventListener('click', function () {
      mobileMenu.classList.toggle('open');
      hamburger.classList.toggle('open');
    });
  }
})();

function nlSubscribe(form) {
  // Browsers block a background (fetch) request to Substack from another
  // site, so the old version never actually subscribed anyone. A normal
  // form submission is allowed: it opens Substack's confirmation page in
  // a new tab, and Substack then emails the reader to confirm.
  form.action = 'https://consilium.substack.com/api/v1/free?nojs=true';
  form.method = 'post';
  form.target = '_blank';
  setTimeout(function () {
    form.innerHTML = '<p style="color:white;font-size:14px;">Thanks. A confirmation page has opened in a new tab. Check your inbox to finish subscribing.</p>';
  }, 400);
  return true;
}
</script>

