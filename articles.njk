---
pagination:
  data: collections.articles
  size: 1
  alias: article
permalink: "articles/{{ article.data.slug }}/index.html"
layout: base.njk
eleventyComputed:
  title: "{{ article.data.seo.seo_title or article.data.title }} — Consilium"
  description: "{{ article.data.seo.meta_description or article.data.teaser }}"
  ogImage: "{{ article.data.seo.social_image or article.data.cover_image }}"
  activePage: articles
  permalinkPath: "articles/{{ article.data.slug }}/"
---
{% set a = article.data %}
{% set authorList = a.authors | resolveAuthors(collections.authors) %}
{% set headings = article.templateContent | extractHeadings %}
{% set relatedItems = (collections.articles | reject("equalto", article)) %}

<style>
:root{--blue:#3D35EB;--blue-deep:#2D28C8;--ink:#123184;--ink-light:#2CB1F4;--lime:#C8F5A0;--grey-bg:#F4F4F8;--grey-border:#E0E0E8;--white:#ffffff;--body-sec:#4A4A63;--r-card:16px;--r-pill:48px;--ease:0.22s ease}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Plus Jakarta Sans',sans-serif;font-size:16px;line-height:1.7;color:var(--ink);background:var(--grey-bg);background-image:radial-gradient(circle, rgba(61,53,235,0.07) 1.5px, transparent 1.5px);background-size:28px 28px;-webkit-font-smoothing:antialiased}
h1,h2,h3,h4{font-family:'Fraunces',serif;font-optical-sizing:auto;line-height:1.1;letter-spacing:-0.02em;text-wrap:balance}
a{color:inherit;text-decoration:none}
.wrap{max-width:1140px;margin:0 auto;padding:0 clamp(20px,5vw,60px)}
.eyebrow{font-family:'Plus Jakarta Sans',sans-serif;font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;display:flex;align-items:center;gap:8px;margin-bottom:18px}
.btn{display:inline-flex;align-items:center;gap:6px;padding:12px 24px;border-radius:var(--r-pill);font-size:14px;font-weight:600;cursor:pointer;text-decoration:none;border:1.5px solid transparent}
nav{position:sticky;top:0;z-index:100;background:var(--blue);height:64px;display:flex;align-items:center}
.nav-icon-primary{fill:#fff}.nav-icon-secondary{fill:rgba(255,255,255,.65)}
.nav-inner{max-width:1140px;margin:0 auto;padding:0 clamp(20px,5vw,60px);display:flex;align-items:center;justify-content:space-between;width:100%}
.nav-logo{display:flex;align-items:center;gap:10px;color:#fff;font-size:17px;font-weight:600;text-decoration:none}
.nav-links{display:flex;align-items:center;gap:clamp(16px,2.5vw,30px);list-style:none}
.nav-links a{color:rgba(255,255,255,.78);font-size:14px;font-weight:500;text-decoration:none}
.nav-links a.active{color:#fff}
.nav-cta{background:rgba(255,255,255,.15)!important;color:#fff!important;border:1px solid rgba(255,255,255,.3)!important;padding:8px 18px!important;border-radius:var(--r-pill)!important;font-weight:600!important}
.hamburger{display:none;flex-direction:column;gap:5px;background:none;border:none;cursor:pointer;padding:8px}
.hamburger span{width:22px;height:2px;background:#fff}
.mobile-menu{display:none}

.article-header{background:#fff;padding:56px 0 40px}
.article-header-inner{max-width:760px}
.byline{display:flex;align-items:center;gap:12px}
.byline-avatar{width:36px;height:36px;border-radius:50%;background:var(--ink);color:#fff;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:600}
.byline-meta{font-size:13px;color:var(--body-sec)}
.byline-meta strong{color:var(--ink);font-weight:600}
.byline-meta a{color:var(--ink);font-weight:600;text-decoration:underline;text-decoration-color:rgba(18,49,132,.3);text-underline-offset:3px}
.byline-meta a:hover{color:var(--blue);text-decoration-color:var(--blue)}
.byline-avatar img{width:100%;height:100%;object-fit:cover;border-radius:50%}

.article-layout{display:grid;grid-template-columns:220px 1fr;gap:56px;padding:48px 0;max-width:1140px}
.toc-rail{position:sticky;top:88px;height:fit-content}
.toc-rail-label{font-size:11px;font-weight:600;letter-spacing:1px;text-transform:uppercase;color:var(--body-sec);margin-bottom:14px}
.toc-rail-links{display:flex;flex-direction:column;gap:10px;border-left:2px solid var(--grey-border);padding-left:14px}
.toc-rail-links a{font-size:13px;color:var(--body-sec)}
.toc-rail-links a:hover{color:var(--blue)}
.toc-mobile{display:none}

.article-main{max-width:680px}
.article-lead{font-size:22px;font-weight:600;color:var(--ink);margin:0 0 28px}
.takeaways-box{background:#fff;border-radius:14px;padding:24px 28px;margin-bottom:32px;border:1px solid var(--grey-border)}
.takeaways-label{font-size:11px;font-weight:600;letter-spacing:1px;text-transform:uppercase;color:var(--blue);margin-bottom:12px}
.takeaways-box ul{margin:0;padding-left:18px;font-size:14px;color:var(--body-sec);line-height:1.9}
.article-body{font-size:19px;line-height:1.75;color:#2A2A40}
.article-body h2{font-size:26px;margin:40px 0 16px;color:var(--ink)}
.article-body p{margin:0 0 20px}
.article-body figure{margin:32px 0}
.article-body img{width:100%;border-radius:12px;display:block}
.article-body figcaption{font-size:12px;color:var(--body-sec);margin-top:10px}
.article-body blockquote{margin:40px 0;padding:0;border:none}
.article-body blockquote p{font-family:'Newsreader',serif;font-style:italic;font-size:28px;line-height:1.4;color:var(--blue);margin:0}

.related-section{background:#fff;padding:48px 0}
.related-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin-top:20px}
.related-card{background:var(--grey-bg);border-radius:14px;padding:22px;display:block}
.related-card h3{font-size:16px;margin:10px 0 0}

@media (max-width:860px){
  .article-layout{grid-template-columns:1fr;padding:24px 0}
  .toc-rail{display:none}
  .toc-mobile{display:block;margin-bottom:16px}
  .article-lead{font-size:19px}
  .article-body{font-size:17px}
  .article-body h2{font-size:22px}
  .related-grid{grid-template-columns:1fr}
  .nav-links{display:none}
  .hamburger{display:flex}
  .mobile-menu.open{display:flex;flex-direction:column;background:var(--blue);position:absolute;top:64px;left:0;right:0;padding:16px 20px;gap:14px}
  .mobile-menu a{color:#fff;font-size:15px}
}
</style>

<div class="article-header">
  <div class="wrap article-header-inner">
    <div class="eyebrow" style="color:var(--blue)">{{ a.tag }}</div>
    <h1 style="font-size:clamp(30px,4vw,44px);margin-bottom:24px">{{ a.title }}</h1>
    <div class="byline">
      {% if authorList.length %}
      <div class="byline-avatar">{% if authorList[0].photo %}<img src="{{ authorList[0].photo }}" alt="">{% else %}{{ authorList[0].name | initials }}{% endif %}</div>
      <div class="byline-meta">{% for au in authorList %}<a href="/authors/{{ au.slug }}/">{{ au.name }}</a>{% if not loop.last %}{% if loop.revindex == 2 %} and {% else %}, {% endif %}{% endif %}{% endfor %} · {{ a.date | date("yyyy") }}{% if a.read_time %} · {{ a.read_time }}{% endif %}</div>
      {% else %}
      <div class="byline-avatar">{{ (a.author or "Consilium") | initials }}</div>
      <div class="byline-meta"><strong>{{ a.author or "Consilium" }}</strong> · {{ a.date | date("yyyy") }}{% if a.read_time %} · {{ a.read_time }}{% endif %}</div>
      {% endif %}
    </div>
  </div>
</div>

<div class="wrap article-layout">

  {% if headings.length %}
  <div class="toc-rail">
    <div class="toc-rail-label">On this page</div>
    <div class="toc-rail-links">
      {% for h in headings %}<a href="#{{ h.id }}">{{ h.text }}</a>{% endfor %}
    </div>
  </div>
  {% else %}
  <div></div>
  {% endif %}

  <div class="article-main">

    {% if headings.length %}
    <details class="toc-mobile" style="background:#fff;border:1px solid var(--grey-border);border-radius:12px;padding:14px 18px">
      <summary style="font-size:12px;font-weight:600;color:var(--ink);cursor:pointer">On this page</summary>
      <div style="display:flex;flex-direction:column;gap:10px;margin-top:12px">
        {% for h in headings %}<a href="#{{ h.id }}" style="font-size:13px;color:var(--body-sec)">{{ h.text }}</a>{% endfor %}
      </div>
    </details>
    {% endif %}

    <p class="article-lead">{{ a.lead }}</p>

    {% if a.takeaways and a.takeaways.length %}
    <div class="takeaways-box">
      <div class="takeaways-label">Key takeaways</div>
      <ul>
        {% for t in a.takeaways %}<li>{{ t.item }}</li>{% endfor %}
      </ul>
    </div>
    {% endif %}

    <div class="article-body">
      {{ article.templateContent | withHeadingIds | safe }}
    </div>
  </div>
</div>

{% if relatedItems.length or collections.reports.length %}
<div class="related-section">
  <div class="wrap">
    <div class="eyebrow" style="color:var(--blue)">More from Consilium</div>
    <div class="related-grid">
      {% for rel in relatedItems | slice(0, 2) %}
      <a href="/articles/{{ rel.data.slug }}/" class="related-card">
        <span class="eyebrow" style="color:var(--blue);margin-bottom:0">{{ rel.data.tag }}</span>
        <h3>{{ rel.data.title }}</h3>
      </a>
      {% endfor %}
      {% for rep in collections.reports | slice(0, 1) %}
      <a href="/reports/{{ rep.data.slug }}/" class="related-card">
        <span class="eyebrow" style="color:var(--blue);margin-bottom:0">{{ rep.data.tag }}</span>
        <h3>{{ rep.data.title }}</h3>
      </a>
      {% endfor %}
    </div>
  </div>
</div>
{% endif %}

<script>
const navEl = document.getElementById('main-nav');
const themed = document.querySelectorAll('[data-nav-theme]');
function updateNav() {
  themed.forEach(function (s) {
    const r = s.getBoundingClientRect();
    if (r.top <= 64 && r.bottom > 64) navEl.setAttribute('data-theme', s.dataset.navTheme);
  });
}
window.addEventListener('scroll', updateNav, { passive: true });
updateNav();
</script>
