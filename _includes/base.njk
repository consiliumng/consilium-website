<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">

<link rel="canonical" href="{{ site.url }}/{{ permalinkPath }}">
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:site_name" content="Consilium">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:image" content="{{ ogImage or 'https://consilium.ng/og-image.png' }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:url" content="{{ site.url }}/{{ permalinkPath }}">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="{{ ogImage or 'https://consilium.ng/og-image.png' }}">

<link rel="icon" type="image/svg+xml" href="data:image/svg+xml;base64,">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700&family=Newsreader:ital,opsz,wght@1,6..72,400&family=Hanken+Grotesk:wght@300..700&display=swap" rel="stylesheet">

<script>
  // Netlify Identity is only needed when someone lands here from an invite,
  // password-recovery or confirmation email (the link carries a token in the
  // URL hash). Everyone else skips the download.
  if (/(invite|recovery|confirmation|email_change)_token=/.test(location.hash)) {
    var ni = document.createElement("script");
    ni.src = "https://identity.netlify.com/v1/netlify-identity-widget.js";
    ni.onload = function () {
      window.netlifyIdentity.on("login", function () {
        document.location.href = "/admin/";
      });
    };
    document.head.appendChild(ni);
  }
</script>
<script async src="https://www.googletagmanager.com/gtag/js?id=G-VVY7VZZE79"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-VVY7VZZE79');
</script>
<style>
/* Logo: the real Consilium logo files. White on Blue, colour on light.
   The two versions cross-fade at the same speed as the nav background. */
.nav-logo { position: relative; }
.nav-logo img, .footer-logo img { height: 30px; width: auto; display: block; }
.nav-logo img { transition: opacity 0.35s ease; }
.nav-logo .logo-colour { position: absolute; left: 0; top: 50%; transform: translateY(-50%); opacity: 0; }
nav[data-theme="light"] .nav-logo .logo-white { opacity: 0; }
nav[data-theme="light"] .nav-logo .logo-colour { opacity: 1; }
.footer-logo { display: inline-block; margin-bottom: 14px; }
</style>
</head>


<body>

<nav id="main-nav" data-nav-theme="dark">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="Consilium home">
      <img class="logo-white" src="/assets/consilium-logo-white.png" alt="Consilium" width="135" height="30">
      <img class="logo-colour" src="/assets/consilium-logo.png" alt="" width="135" height="30" aria-hidden="true">
    </a>
    <ul class="nav-links">
      <li><a href="/#what-we-do">What we do</a></li>
      <li><a href="/reports/"{% if activePage == 'reports' %} class="active"{% endif %}>Reports</a></li>
      <li><a href="/articles/"{% if activePage == 'articles' %} class="active"{% endif %}>Articles</a></li>
      <li><a href="/#about">About</a></li>
      <li><a href="/contact.html" class="nav-cta"{% if activePage == 'contact' %} style="text-decoration:underline"{% endif %}>Work with us →</a></li>
    </ul>
    <button class="hamburger" id="hamburger" aria-label="Open navigation">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="mobile-menu" id="mobile-menu">
    <a href="/#what-we-do">What we do</a>
    <a href="/reports/">Reports</a>
    <a href="/articles/">Articles</a>
    <a href="/#about">About</a>
    <a href="/contact.html">Work with us →</a>
  </div>
</nav>

{{ content | safe }}

<footer data-nav-theme="dark">
  <div class="wrap">
    <div class="footer-tagline-block">
      <p>Evidence for better<br>healthcare decisions.</p>
    </div>
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="Consilium home">
          <img src="/assets/consilium-logo-white.png" alt="Consilium" width="135" height="30">
        </a>
        <p>Nigeria's health systems intelligence and advisory firm. Making sense of Nigerian healthcare in a way that actually matters.</p>
      </div>
      <div>
        <p class="footer-col-label">Latest work</p>
        <ul class="footer-links">
          {%- for report in collections.reports %}
          <li><a href="/reports/{{ report.data.slug }}/">{{ report.data.title }}</a></li>
          {%- endfor %}
          {%- for c in site.commissioned %}
          <li><a href="{{ c.url }}">{{ c.title }}</a></li>
          {%- endfor %}
        </ul>
      </div>
      <div>
        <p class="footer-col-label">Stay informed</p>
        <p class="footer-nl-label">The Consilium newsletter — Nigerian healthcare, in analysis.</p>
        <form class="footer-nl-form" onsubmit="return nlSubscribe(this)">
          <input class="footer-nl-input" type="email" name="email" placeholder="Email address" aria-label="Email address" required>
          <button class="footer-nl-btn" type="submit">→</button>
        </form>
      </div>
    </div>
    <hr class="footer-hr">
    <div class="footer-bottom">
      <p class="footer-copy">© {{ buildYear }} Consilium · <a href="mailto:office@consilium.ng">office@consilium.ng</a> · <a href="https://consilium.substack.com">Substack</a></p>
      <p class="footer-method">Research · Policy analysis · Data tools</p>
    </div>
  </div>
</footer>

<script>
// ============================================================
// SHARED BEHAVIOR — mobile nav toggle, newsletter footer form
// ============================================================
(function () {
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobile-menu');
  if (hamburger && mobileMenu) {
    hamburger.addEventListener('click', function () {
      mobileMenu.classList.toggle('open');
      hamburger.classList.toggle('open');
    });
  }
})();

function substackSubscribe(email) {
  // Opens Substack's own confirmation page in a new tab (browsers block
  // quiet background sign-ups). Call it straight from a click handler so
  // the pop-up is not blocked.
  var f = document.createElement('form');
  f.action = 'https://consilium.substack.com/api/v1/free?nojs=true';
  f.method = 'post';
  f.target = '_blank';
  f.style.display = 'none';
  var i = document.createElement('input');
  i.type = 'hidden'; i.name = 'email'; i.value = email;
  f.appendChild(i);
  document.body.appendChild(f);
  f.submit();
  setTimeout(function () { f.remove(); }, 1000);
}

function nlSubscribe(form) {
  // Browsers block a background (fetch) request to Substack from another
  // site, so the old version never actually subscribed anyone. A normal
  // form submission is allowed: it opens Substack's confirmation page in
  // a new tab, and Substack then emails the reader to confirm.
  form.action = 'https://consilium.substack.com/api/v1/free?nojs=true';
  form.method = 'post';
  form.target = '_blank';
  setTimeout(function () {
    form.innerHTML = '<p style="color:white;font-size:14px;">Thanks. A confirmation page has opened in a new tab. Check your inbox to finish subscribing.</p>';
  }, 400);
  return true;
}
</script>

</body>
</html>
